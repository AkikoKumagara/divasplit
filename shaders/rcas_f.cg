/*
 * The game's final blit with sharpening: AMD FidelityFX FSR 1 RCAS (robust
 * contrast-adaptive sharpening, without its optional noise reduction) on the
 * image as the blit stretches it. Five bilinear reads one source texel apart;
 * the lobe is limited per pixel so it never pushes past the neighbours'
 * minimum / maximum.
 *
 *   k.xy  one source texel in UV (1 / texture size), k.z strength 0..1
 *   lim   the image's area in the texture, half a texel in (reads are clamped
 *         to it: the rest of the texture holds stale pixels)
 *   col   the game's blit colour (multiplied in, as the original blit does)
 *
 * FSR 1 is MIT-licensed, Copyright (c) 2021 Advanced Micro Devices, Inc.
 */
float4 main(float2 uv : TEXCOORD0, uniform sampler2D tex,
            uniform float4 k, uniform float4 lim, uniform float4 col) : COLOR
{
    float3 b = tex2D(tex, clamp(uv + float2(0.0, -k.y), lim.xy, lim.zw)).rgb;
    float3 d = tex2D(tex, clamp(uv + float2(-k.x, 0.0), lim.xy, lim.zw)).rgb;
    float4 e4 = tex2D(tex, clamp(uv, lim.xy, lim.zw));
    float3 e = e4.rgb;
    float3 f = tex2D(tex, clamp(uv + float2(k.x, 0.0), lim.xy, lim.zw)).rgb;
    float3 h = tex2D(tex, clamp(uv + float2(0.0, k.y), lim.xy, lim.zw)).rgb;

    float3 mn4 = min(min(b, d), min(f, h));
    float3 mx4 = max(max(b, d), max(f, h));
    // how far the lobe can go before a neighbour would clip at 0 or at 1
    // (the small terms keep black and white areas finite)
    float3 hitMin = min(mn4, e) / (4.0 * mx4 + 1.0 / 256.0);
    float3 hitMax = (1.0 - max(mx4, e)) / (4.0 * mn4 - 4.0 - 1.0 / 256.0);
    float3 lobe3 = max(-hitMin, hitMax);
    float lobe = max(-0.1875, min(max(lobe3.r, max(lobe3.g, lobe3.b)), 0.0)) * k.z;

    float3 c = (lobe * (b + d + f + h) + e) / (4.0 * lobe + 1.0);
    return float4(c, e4.a) * col;
}
